#!/usr/bin/env bash
set -e

dotspath="/home/laub/foo/fooldots"

usage() {
    printf "Usage: $(basename "$0") \n     -e <repo-rpath> , (open editor in fooldots)\n     -m <source-path> <repo-rpath> , (move config file to fooldots and create a symlink)\n     -f/d <file/dir-repo-rpath> <link-path> , (create symlink to new config file/directory in fooldots)\n     -s (edit script source code)\n     -b <external-commands...>\n      <git-args...>\n" >&2
    exit 2
}

case "${1-}" in
    -e)
        (($# == 2)) || usage
        exec nvim -- "$dotspath/$2"
        ;;

    -m)
        (($# == 3)) || usage
        src=$2
        target="$dotspath/$3"

        mkdir -p "$(dirname "$target")"
        mv -- "$src" "$target"
        ln -s -- "$target" "$src"
        ;;

    -f | -d)
        (($# == 3)) || usage
 

        path="$dotspath/$2"
	    link="$3"

        if [ $1 == -f ]; then
            mkdir -p -- "$(dirname "$path")"
            touch -- "$path"
        else 
            mkdir -p -- "$path"
        fi

        if [[ -e "$link" && ! -L "$link" ]]; then
            echo "Refusing to replace existing non-symlink: $link" >&2
            exit 1
        fi

        ln -sfn -- "$path" "$link"
        nvim -- "$path"
        ;;

    -s)
        exec nvim -- "$0"
        ;;

    *)
    	(($#)) || usage
        cd -- "$dotspath"
        if [ $1 == "-b" ]; then
            exec "${@:2}"
        else
            exec git "$@"
        fi
        ;;
esac

